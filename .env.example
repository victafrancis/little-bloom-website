# Resend API Configuration
# Get your API key from https://resend.com/api-keys
VITE_RESEND_API_KEY=your_resend_api_key_here

# Supabase Configuration
# Get your project URL and anon key from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Sentry Configuration
# Get your DSN from https://sentry.io/settings/projects/YOUR_PROJECT/keys/
VITE_SENTRY_DSN=your_sentry_dsn_here

# Instagram feed (server-only; see docs/instagram-feed.md)
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
CRON_SECRET=a_random_string_of_16_or_more_characters
